<mxCell id="c132" value="&lt;b&gt;holterdb respaldar&lt;/b&gt; (manual)&lt;br&gt;DB: API de backup de SQLite → copia fechada&lt;br&gt;+ integrity_check + conteo de filas → tabla &lt;b&gt;respaldo&lt;/b&gt;&lt;br&gt;Señales y PDFs: rsync incremental&lt;br&gt;&lt;i&gt;aviso al conectar si la DB cambió desde el último respaldo&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1260" y="470" width="330" height="110" as="geometry"/></mxCell>
