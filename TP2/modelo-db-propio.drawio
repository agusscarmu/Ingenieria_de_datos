<mxCell id="c119" value="&lt;b&gt;DB/holter.db&lt;/b&gt;&lt;br&gt;SQLite · un solo archivo · ~decenas de MB&lt;br&gt;&lt;br&gt;&lt;b&gt;OLTP&lt;/b&gt; (DER): paciente · estudio · senal · informe · etiqueta …&lt;br&gt;&lt;br&gt;&lt;b&gt;Capa analítica&lt;/b&gt; (modelo dimensional):&lt;br&gt;dim_* y fact_* regenerables desde el OLTP" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="170" width="300" height="260" as="geometry"/></mxCell>
